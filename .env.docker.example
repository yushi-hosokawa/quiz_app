# Docker環境用の環境変数設定ファイル
# このファイルを .env.docker にコピーして使用してください
# 本番環境では必ず強力なパスワードに変更してください

# ========================================
# MariaDB設定
# ========================================
MYSQL_ROOT_PASSWORD=rootpassword_change_this
DATABASE_NAME=quiz_app
DATABASE_USER=quizapp
DATABASE_PASSWORD=passoword123_change_this

# ========================================
# ポート設定
# ========================================
# Nuxtアプリケーションのポート（ホスト側）
APP_PORT=3000

# MariaDBのポート（ホスト側）
DB_PORT=3306

# Nginxのポート（ホスト側）
NGINX_PORT=8080
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Vite開発サーバーのWebSocketポート（開発環境のみ）
DEV_WS_PORT=24678

# ========================================
# アプリケーション設定
# ========================================
NODE_ENV=production

# データベース接続URL（自動生成されるため通常は変更不要）
# 形式: mysql://ユーザー名:パスワード@ホスト:ポート/データベース名
# Docker内では 'db' サービス名を使用
DATABASE_URL=mysql://quizapp:passoword123_change_this@db:3306/quiz_app
