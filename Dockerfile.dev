# 開発環境用のDockerfile
FROM node:20-alpine

WORKDIR /app

# 必要なパッケージのインストール
RUN apk add --no-cache \
    git \
    python3 \
    make \
    g++

# package.jsonとpackage-lock.jsonをコピー
COPY package*.json ./
COPY prisma ./prisma/

# 依存関係のインストール（開発依存関係を含む）
RUN npm ci

# Prismaクライアントの生成
RUN npx prisma generate

# 環境変数の設定
ENV NODE_ENV=development
ENV NUXT_HOST=0.0.0.0
ENV NUXT_PORT=3000

# ポートの公開
EXPOSE 3000

# 開発サーバーの起動
CMD ["npm", "run", "dev"]
