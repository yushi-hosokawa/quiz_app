// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// プログラミング言語テーブル
model Language {
  id         Int       @id @default(autoincrement())
  name       String    @unique @db.VarChar(50)
  createdAt  DateTime  @default(now()) @map("created_at")
  problems   Problem[]

  @@map("languages")
}

// ジャンルテーブル
model Genre {
  id         Int       @id @default(autoincrement())
  name       String    @unique @db.VarChar(100)
  createdAt  DateTime  @default(now()) @map("created_at")
  problems   Problem[]

  @@map("genres")
}

// 問題テーブル
model Problem {
  id            Int            @id @default(autoincrement())
  questionType  String         @map("question_type") @db.VarChar(20) // choice, text, code
  questionText  String         @map("question_text") @db.Text
  answerText    String?        @map("answer_text") @db.Text
  explanation   String?        @db.Text
  languageId    Int?           @map("language_id")
  genreId       Int?           @map("genre_id")
  difficulty    String?        @db.VarChar(20) // easy, medium, hard
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  language      Language?      @relation(fields: [languageId], references: [id])
  genre         Genre?         @relation(fields: [genreId], references: [id])
  choices       Choice[]
  tags          ProblemTag[]
  studyRecords  StudyRecord[]

  @@map("problems")
  @@index([languageId])
  @@index([genreId])
  @@index([questionType])
}

// 選択肢テーブル
model Choice {
  id           Int      @id @default(autoincrement())
  problemId    Int      @map("problem_id")
  choiceText   String   @map("choice_text") @db.Text
  isCorrect    Boolean  @default(false) @map("is_correct")
  displayOrder Int      @map("display_order")

  problem      Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@map("choices")
  @@index([problemId])
}

// タグテーブル
model ProblemTag {
  id        Int      @id @default(autoincrement())
  problemId Int      @map("problem_id")
  tagName   String   @map("tag_name") @db.VarChar(50)

  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@map("problem_tags")
  @@index([problemId])
  @@index([tagName])
}

// 学習セッションテーブル
model StudySession {
  id             Int           @id @default(autoincrement())
  sessionStart   DateTime      @map("session_start") @default(now())
  sessionEnd     DateTime?     @map("session_end")
  totalQuestions Int           @default(0) @map("total_questions")

  studyRecords   StudyRecord[]

  @@map("study_sessions")
}

// 学習記録テーブル
model StudyRecord {
  id          Int           @id @default(autoincrement())
  sessionId   Int           @map("session_id")
  problemId   Int           @map("problem_id")
  isCorrect   Boolean       @map("is_correct")
  userAnswer  String?       @map("user_answer") @db.Text
  answeredAt  DateTime      @default(now()) @map("answered_at")
  timeSpent   Int?          @map("time_spent") // 秒単位

  session     StudySession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  problem     Problem       @relation(fields: [problemId], references: [id])

  @@map("study_records")
  @@index([sessionId])
  @@index([problemId])
  @@index([answeredAt])
}
