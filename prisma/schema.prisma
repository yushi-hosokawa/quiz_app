generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Language {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(50)
  createdAt DateTime  @default(now()) @map("created_at")
  problems  Problem[]

  @@map("languages")
}

model Genre {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at")
  problems  Problem[]

  @@map("genres")
}

model Problem {
  id           Int           @id @default(autoincrement())
  questionType String        @map("question_type") @db.VarChar(20)
  questionText String        @map("question_text") @db.Text
  answerText   String?       @map("answer_text") @db.Text
  explanation  String?       @db.Text
  languageId   Int?          @map("language_id")
  genreId      Int?          @map("genre_id")
  difficulty   String?       @db.VarChar(20)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  choices      Choice[]
  tags         ProblemTag[]
  genre        Genre?        @relation(fields: [genreId], references: [id])
  language     Language?     @relation(fields: [languageId], references: [id])
  studyRecords StudyRecord[]

  @@index([languageId])
  @@index([genreId])
  @@index([questionType])
  @@map("problems")
}

model Choice {
  id           Int     @id @default(autoincrement())
  problemId    Int     @map("problem_id")
  choiceText   String  @map("choice_text") @db.Text
  isCorrect    Boolean @default(false) @map("is_correct")
  displayOrder Int     @map("display_order")
  problem      Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
  @@map("choices")
}

model ProblemTag {
  id        Int     @id @default(autoincrement())
  problemId Int     @map("problem_id")
  tagName   String  @map("tag_name") @db.VarChar(50)
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
  @@index([tagName])
  @@map("problem_tags")
}

model StudySession {
  id             Int           @id @default(autoincrement())
  sessionStart   DateTime      @default(now()) @map("session_start")
  sessionEnd     DateTime?     @map("session_end")
  totalQuestions Int           @default(0) @map("total_questions")
  studyRecords   StudyRecord[]

  @@map("study_sessions")
}

model StudyRecord {
  id         Int          @id @default(autoincrement())
  sessionId  Int          @map("session_id")
  problemId  Int          @map("problem_id")
  isCorrect  Boolean      @map("is_correct")
  userAnswer String?      @map("user_answer") @db.Text
  answeredAt DateTime     @default(now()) @map("answered_at")
  timeSpent  Int?         @map("time_spent")
  problem    Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  session    StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([problemId])
  @@index([answeredAt])
  @@map("study_records")
}
